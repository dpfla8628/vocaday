  {"id":"g2-022","lv":2,"tag":"want + 목적어 + to","s":"I {want you to} come to my party.","ko":"네가 내 파티에 왔으면 좋겠어.","alt":["would like you to"],"tip":"want + 사람 + to = 그 사람이 ~하길 원해","bank":["that","wants","your"]},
  {"id":"g2-023","lv":2,"tag":"ask + 목적어 + to","s":"My boss {asked me to} stay late.","ko":"상사가 나한테 늦게까지 남아 달라고 부탁했어.","alt":[],"tip":"ask + 사람 + to = ~해 달라고 부탁하다","bank":["I","asking","my"]},
  {"id":"g2-024","lv":2,"tag":"tell + 목적어 + not to","s":"The doctor {told me not to} drink coffee.","ko":"의사가 커피 마시지 말라고 했어.","alt":["said not to"],"tip":"to부정사 부정은 not to","bank":["said","don't","no"]},
  {"id":"g2-025","lv":2,"tag":"가주어 it","s":"It's not easy {to find} a parking spot here.","ko":"여기서 주차 자리 찾기 쉽지 않아.","alt":[],"tip":"It is + 형용사 + to부정사 (가주어 it)","bank":["for","finds","of"]},
  {"id":"g2-026","lv":2,"tag":"가주어 it (of)","s":"It's {kind of you} to say that.","ko":"그렇게 말해 주시다니 친절하시네요.","alt":["nice of you","sweet of you"],"tip":"성격 형용사 + of + 사람 + to","bank":["for","kindly","your"]},
  {"id":"g2-027","lv":2,"tag":"동명사 주어","s":"{Walking} to work is good exercise.","ko":"걸어서 출근하는 건 좋은 운동이야.","alt":[],"tip":"-ing가 주어면 '~하는 것', 단수 취급","bank":["Walk","Walks","Walked"]},
  {"id":"g2-028","lv":2,"tag":"동명사 목적어","s":"I really {enjoy cooking} on weekends.","ko":"주말엔 요리하는 걸 정말 즐겨.","alt":[],"tip":"enjoy 뒤에는 동명사(-ing)","bank":["to","cook","enjoys"]},
  {"id":"g2-029","lv":2,"tag":"동명사 목적어","s":"Did you {finish writing} the report?","ko":"보고서 다 썼어?","alt":[],"tip":"finish 뒤에는 동명사(-ing)","bank":["to","finished","wrote"]},
  {"id":"g2-030","lv":2,"tag":"동명사 목적어","s":"I {stopped drinking} soda.","ko":"탄산음료 끊었어.","alt":["quit drinking","gave up drinking"],"tip":"stop -ing = ~하는 것을 그만두다","bank":["to","drink","stops"]},
  {"id":"g2-031","lv":2,"tag":"전치사 + 동명사","s":"Thank you {for helping} me.","ko":"도와줘서 고마워요.","alt":[],"tip":"Thank you for -ing = ~해 줘서 고마워","bank":["to","help","helped"]},
  {"id":"g2-032","lv":2,"tag":"전치사 + 동명사","s":"I'm not good {at remembering} names.","ko":"나 이름을 잘 못 외워.","alt":[],"tip":"be good at -ing = ~을 잘하다","bank":["to","remember","on"]},
  {"id":"g2-033","lv":2,"tag":"패턴: Would you mind -ing","s":"Would you {mind closing} the door?","ko":"문 좀 닫아 주시겠어요?","alt":["mind shutting"],"tip":"Would you mind -ing? = ~해 주시겠어요?","bank":["to","closed","minding"]},
  {"id":"g2-034","lv":2,"tag":"패턴: Do you mind if","s":"{Do you mind if} I open the window?","ko":"창문 좀 열어도 될까요?","alt":["Would you mind if"],"tip":"Do you mind if I ~? = ~해도 될까요?","bank":["Are","Does","minding"]},
  {"id":"g2-035","lv":2,"tag":"패턴: I'm looking forward to","s":"I'm looking forward {to seeing} you.","ko":"만나길 기대하고 있어.","alt":["to meeting"],"tip":"look forward to 뒤에는 -ing (to는 전치사)","bank":["see","for","seen"]},
  {"id":"g2-036","lv":2,"tag":"패턴: feel like -ing","s":"I don't {feel like going} out tonight.","ko":"오늘 밤엔 나가고 싶지 않아.","alt":[],"tip":"feel like -ing = ~하고 싶은 기분이다","bank":["to","goes","went"]},
  {"id":"g2-037","lv":2,"tag":"패턴: can't help -ing","s":"I {can't help laughing} at that video.","ko":"그 영상 보면 웃음을 참을 수가 없어.","alt":[],"tip":"can't help -ing = ~하지 않을 수 없다","bank":["to","laughed","laughs"]},
  {"id":"g2-038","lv":2,"tag":"패턴: I'm thinking of","s":"I'm {thinking of moving} to Seoul.","ko":"서울로 이사할까 생각 중이야.","alt":["thinking about moving"],"tip":"be thinking of -ing = ~할까 생각 중","bank":["to","move","think"]},
  {"id":"g2-039","lv":2,"tag":"패턴: How about -ing","s":"{How about going} for a walk?","ko":"산책하러 가는 거 어때?","alt":["What about going"],"tip":"How about -ing? = ~하는 거 어때?","bank":["to","go","goes"]},
  {"id":"g2-040","lv":2,"tag":"수동태","s":"This phone {was made} in Korea.","ko":"이 폰은 한국에서 만들어졌어.","alt":[],"tip":"수동태 = be동사 + p.p.","bank":["make","making","did"]},
  {"id":"g2-041","lv":2,"tag":"수동태 과거","s":"My bike {was stolen} last night.","ko":"어젯밤에 자전거 도둑맞았어.","alt":["got stolen"],"tip":"당한 일은 was/were + p.p.","bank":["stole","is","steal"]},
  {"id":"g2-042","lv":2,"tag":"수동태","s":"Is breakfast {included} in the price?","ko":"가격에 조식 포함인가요?","alt":[],"tip":"be included = 포함되다","bank":["include","including","includes"]},
  {"id":"g2-043","lv":2,"tag":"수동태 미래","s":"The meeting {will be held} on Monday.","ko":"회의는 월요일에 열릴 거예요.","alt":["is going to be held"],"tip":"미래 수동태는 will be + p.p.","bank":["hold","holding","been"]},
  {"id":"g2-044","lv":2,"tag":"현재완료 수동태","s":"Our flight {has been canceled}.","ko":"우리 비행기가 결항됐어.","alt":["has been cancelled","was canceled","was cancelled","got canceled","got cancelled"],"tip":"완료 수동태는 have been + p.p.","bank":["have","cancel","being"]},
  {"id":"g2-045","lv":2,"tag":"수동태 과거","s":"We {were invited} to their wedding.","ko":"우리 그 사람들 결혼식에 초대받았어.","alt":["got invited"],"tip":"초대받다 = be invited","bank":["was","invite","inviting"]},
  {"id":"g2-046","lv":2,"tag":"수동태 의문문","s":"What {is this called} in English?","ko":"이거 영어로 뭐라고 해요?","alt":[],"tip":"be called = ~라고 불리다","bank":["do","call","calling"]},
  {"id":"g2-047","lv":2,"tag":"관계대명사 who","s":"I have a friend {who lives} in New York.","ko":"뉴욕에 사는 친구가 있어.","alt":["that lives"],"tip":"사람을 꾸밀 땐 who + 동사","bank":["live","which","whose"]},
  {"id":"g2-048","lv":2,"tag":"관계대명사 that","s":"The pasta {that I ordered} was really good.","ko":"내가 시킨 파스타 정말 맛있었어.","alt":["which I ordered","I ordered"],"tip":"목적격 관계대명사 that은 생략 가능","bank":["who","what","order"]},
  {"id":"g2-049","lv":2,"tag":"관계대명사 whose","s":"I met a guy {whose} dad is a chef.","ko":"아빠가 셰프인 남자를 만났어.","alt":[],"tip":"소유 관계는 whose + 명사","bank":["who","who's","his"]},
  {"id":"g2-050","lv":2,"tag":"관계대명사 what","s":"{What I need} is a long vacation.","ko":"내게 필요한 건 긴 휴가야.","alt":[],"tip":"what = ~하는 것 (선행사 포함)","bank":["That","Which","needs"]},
  {"id":"g2-051","lv":2,"tag":"관계대명사 what","s":"That's not {what I} meant.","ko":"내 말은 그런 뜻이 아니었어.","alt":[],"tip":"what I meant = 내가 의도한 것","bank":["that","which","who"]},
  {"id":"g2-052","lv":2,"tag":"패턴: That's why","s":"{That's why} I was late.","ko":"그래서 내가 늦었던 거야.","alt":["That is why"],"tip":"That's why ~ = 그래서 ~인 거야","bank":["What's","reason","for"]},
  {"id":"g2-053","lv":2,"tag":"접속사 if","s":"{If it rains}, we'll stay home.","ko":"비 오면 우리 집에 있을 거야.","alt":[],"tip":"조건절은 미래라도 현재시제","bank":["will","rain","raining"]},
  {"id":"g2-054","lv":2,"tag":"접속사 when","s":"Call me {when you get} home.","ko":"집에 도착하면 전화해.","alt":["when you arrive","once you get"],"tip":"때 부사절도 미래 대신 현재시제","bank":["will","got","gets"]},
  {"id":"g2-055","lv":2,"tag":"접속사 because","s":"I stayed home {because I was} sick.","ko":"아파서 집에 있었어.","alt":["since I was","as I was"],"tip":"because + 주어 + 동사 = ~때문에","bank":["of","am","were"]},
  {"id":"g2-056","lv":2,"tag":"접속사 although","s":"{Although} it was cold, we went hiking.","ko":"추웠지만 우리는 등산하러 갔어.","alt":["Though","Even though"],"tip":"although = 비록 ~이지만","bank":["But","Despite","Because"]},
  {"id":"g2-057","lv":2,"tag":"접속사 while","s":"Someone called {while you were} out.","ko":"너 나가 있는 동안 누가 전화했어.","alt":[],"tip":"while = ~하는 동안","bank":["during","was","are"]},
  {"id":"g2-058","lv":2,"tag":"접속사 until","s":"Let's wait {until} the rain stops.","ko":"비 그칠 때까지 기다리자.","alt":["till"],"tip":"until = ~할 때까지","bank":["by","for","during"]},
  {"id":"g2-059","lv":2,"tag":"접속사 before","s":"Wash your hands {before} you eat.","ko":"먹기 전에 손 씻어.","alt":[],"tip":"before + 주어 + 동사 = ~하기 전에","bank":["ago","front","prior"]},
  {"id":"g2-060","lv":2,"tag":"조동사 must","s":"You {must wear} a seatbelt.","ko":"안전벨트는 반드시 매야 해.","alt":["have to wear","need to wear","have got to wear"],"tip":"must + 동사원형 = 반드시 ~해야 한다","bank":["to","wearing","wears"]},
  {"id":"g2-061","lv":2,"tag":"must 추측","s":"You {must be} tired after that long flight.","ko":"그렇게 오래 비행기 탔으니 피곤하겠다.","alt":[],"tip":"must be = ~임에 틀림없다 (강한 추측)","bank":["to","is","been"]},
  {"id":"g2-062","lv":2,"tag":"조동사 should","s":"You {should see} a doctor.","ko":"병원에 가 보는 게 좋겠어.","alt":["should go see"],"tip":"should + 동사원형 = ~하는 게 좋겠다","bank":["to","seeing","sees"]},
  {"id":"g2-063","lv":2,"tag":"조동사 should 부정","s":"You {shouldn't skip} breakfast.","ko":"아침은 거르지 않는 게 좋아.","alt":["should not skip"],"tip":"shouldn't = ~하지 않는 게 좋다","bank":["not","skipping","to"]},
  {"id":"g2-064","lv":2,"tag":"have to","s":"I {have to work} this weekend.","ko":"이번 주말에 일해야 해.","alt":["need to work","must work","have got to work"],"tip":"have to + 동사원형 = ~해야 한다","bank":["has","working","for"]},
  {"id":"g2-065","lv":2,"tag":"don't have to","s":"You {don't have to} bring anything.","ko":"아무것도 안 가져와도 돼.","alt":["don't need to","do not need to"],"tip":"don't have to = ~할 필요 없다","bank":["doesn't","has","must"]},
  {"id":"g2-066","lv":2,"tag":"had to","s":"I {had to} take a taxi this morning.","ko":"오늘 아침에 택시를 타야 했어.","alt":["needed to"],"tip":"have to의 과거는 had to","bank":["has","having","for"]},
  {"id":"g2-067","lv":2,"tag":"had better","s":"{You'd better} hurry up.","ko":"서두르는 게 좋을 거야.","alt":["You had better","You better"],"tip":"had better = ~하는 게 좋을 거야 (경고)","bank":["more","good","to"]},
  {"id":"g2-068","lv":2,"tag":"조동사 may 추측","s":"It {may rain} this afternoon.","ko":"오후에 비가 올지도 몰라.","alt":["might rain","could rain"],"tip":"may/might = ~일지도 모른다","bank":["rains","raining","to"]},
  {"id":"g2-069","lv":2,"tag":"used to","s":"I {used to} live in Busan when I was a kid.","ko":"어릴 때 부산에 살았었어.","alt":[],"tip":"used to = 예전에 ~했었다 (지금은 아님)","bank":["use","using","was"]},
  {"id":"g2-070","lv":2,"tag":"used to","s":"There {used to be} a bakery here.","ko":"여기 예전에 빵집이 있었는데.","alt":[],"tip":"There used to be = 예전엔 ~가 있었다","bank":["use","been","being"]},
  {"id":"g2-071","lv":2,"tag":"가정법 과거","s":"If I {were} you, I'd take the job.","ko":"내가 너라면 그 일 할 거야.","alt":["was"],"tip":"현재 반대 가정은 If + 과거 (be는 were)","bank":["am","be","is"]},
  {"id":"g2-072","lv":2,"tag":"가정법 과거","s":"If I had more time, I {would travel} more.","ko":"시간이 더 있으면 여행을 더 다닐 텐데.","alt":["'d travel"],"tip":"가정법 과거: If 과거, would + 동사원형","bank":["will","traveled","can"]},
  {"id":"g2-073","lv":2,"tag":"I wish 가정법","s":"I wish I {could} speak Spanish.","ko":"스페인어를 할 수 있으면 좋을 텐데.","alt":[],"tip":"I wish + 과거 = ~라면 좋을 텐데","bank":["can","will","am"]},
  {"id":"g2-074","lv":2,"tag":"I wish 가정법","s":"I wish I {had} a car.","ko":"차가 있으면 좋을 텐데.","alt":[],"tip":"지금 없는 걸 바랄 땐 I wish I had","bank":["have","has","having"]},
  {"id":"g2-075","lv":2,"tag":"간접의문문","s":"Do you know {where the restroom} is?","ko":"화장실이 어디인지 아세요?","alt":["where the bathroom"],"tip":"간접의문문은 의문사 + 주어 + 동사 순서","bank":["is","what","does"]},
  {"id":"g2-076","lv":2,"tag":"간접의문문","s":"Can you tell me {what time it} is?","ko":"지금 몇 시인지 알려 주실래요?","alt":[],"tip":"what time it is (주어 + 동사 순서)","bank":["is","does","clock"]},
  {"id":"g2-077","lv":2,"tag":"간접의문문 if","s":"I'm not sure {if} he's coming.","ko":"그가 올지 잘 모르겠어.","alt":["whether"],"tip":"의문사 없는 간접의문문은 if/whether","bank":["what","which","does"]},
  {"id":"g2-078","lv":2,"tag":"간접의문문","s":"I wonder {why she} is so upset.","ko":"그녀가 왜 그렇게 화났는지 궁금해.","alt":[],"tip":"I wonder + 의문사 + 주어 + 동사","bank":["is","her","does"]},
  {"id":"g2-079","lv":2,"tag":"사역동사 make","s":"My mom {made me} clean my room.","ko":"엄마가 나한테 방 청소를 시켰어.","alt":["had me","got me to"],"tip":"make + 사람 + 동사원형 = ~하게 시키다","bank":["make","to","my"]},
  {"id":"g2-080","lv":2,"tag":"사역동사 let","s":"{Let me} know when you're ready.","ko":"준비되면 알려 줘.","alt":[],"tip":"let + 사람 + 동사원형 = ~하게 해 주다","bank":["Let's","I","Make"]},
  {"id":"g2-081","lv":2,"tag":"have + 목적어 + p.p.","s":"I had my hair {cut} yesterday.","ko":"어제 머리 잘랐어 (미용실에서).","alt":[],"tip":"have + 사물 + p.p. = (남이) ~하게 하다","bank":["cutting","cutted","to"]},
  {"id":"g2-082","lv":2,"tag":"지각동사","s":"I saw him {leave} the office early.","ko":"그가 일찍 퇴근하는 걸 봤어.","alt":["leaving"],"tip":"see + 사람 + 동사원형/-ing","bank":["to","left","leaves"]},
  {"id":"g2-083","lv":2,"tag":"패턴: I'm afraid","s":"{I'm afraid} we're fully booked tonight.","ko":"죄송하지만 오늘 밤은 예약이 꽉 찼어요.","alt":[],"tip":"I'm afraid ~ = 유감이지만 ~","bank":["fear","worry","am"]},
  {"id":"g2-084","lv":2,"tag":"too ~ to","s":"It's {too hot to} sleep.","ko":"너무 더워서 잠을 못 자겠어.","alt":[],"tip":"too + 형용사 + to = 너무 ~해서 못 하다","bank":["so","very","that"]},
  {"id":"g2-085","lv":2,"tag":"so ~ that","s":"I was {so tired that} I fell asleep on the bus.","ko":"너무 피곤해서 버스에서 잠들었어.","alt":["so tired"],"tip":"so + 형용사 + that = 너무 ~해서 …하다","bank":["too","very","such"]},
  {"id":"g2-086","lv":2,"tag":"enough to","s":"You're old {enough to} decide for yourself.","ko":"너도 스스로 결정할 만한 나이잖아.","alt":[],"tip":"형용사 + enough to = ~할 만큼 충분히","bank":["for","too","so"]},
  {"id":"g2-087","lv":2,"tag":"부가의문문","s":"You like spicy food, {don't you}?","ko":"너 매운 음식 좋아하지, 그렇지?","alt":[],"tip":"긍정문 뒤엔 부정 부가의문문","bank":["aren't","doesn't","isn't"]},
  {"id":"g2-088","lv":2,"tag":"부가의문문","s":"It's a beautiful day, {isn't it}?","ko":"날씨 진짜 좋다, 그치?","alt":["is it not"],"tip":"be동사 문장은 be동사로 되묻기","bank":["doesn't","wasn't","aren't"]},
  {"id":"g2-089","lv":2,"tag":"부가의문문","s":"Let's take a break, {shall we}?","ko":"좀 쉬자, 그럴까?","alt":[],"tip":"Let's 문장의 부가의문문은 shall we","bank":["will","don't","us"]},
  {"id":"g2-090","lv":2,"tag":"접속사 as soon as","s":"Call me {as soon as} you land.","ko":"착륙하자마자 전화해.","alt":["once"],"tip":"as soon as = ~하자마자","bank":["fast","quickly","so"]},
  {"id":"g2-091","lv":2,"tag":"최상급 + ever","s":"This is {the best} coffee I've ever had.","ko":"이거 지금까지 마셔 본 커피 중에 최고야.","alt":[],"tip":"the 최상급 + I've ever p.p. = 지금껏 최고","bank":["a","better","most"]},
  {"id":"g2-092","lv":2,"tag":"감탄문","s":"{What a} beautiful view!","ko":"경치 정말 멋지다!","alt":[],"tip":"What a + 형용사 + 명사! = 정말 ~하다!","bank":["How","an","So"]},
  {"id":"g2-093","lv":2,"tag":"패턴: I'm about to","s":"I'm {about to} leave. Can I call you back?","ko":"막 나가려던 참이야. 다시 전화해도 될까?","alt":[],"tip":"be about to = 막 ~하려던 참이다","bank":["for","will","around"]},
